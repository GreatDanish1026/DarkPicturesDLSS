// Version resource for QuarryDLSS.addon64 / DarkPicturesDLSS.addon64 (see version.h).
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     QDLSS_VERSION_MAJOR, QDLSS_VERSION_MINOR, QDLSS_VERSION_PATCH, 0
PRODUCTVERSION  QDLSS_VERSION_MAJOR, QDLSS_VERSION_MINOR, QDLSS_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      QDLSS_PRODUCT
            VALUE "FileDescription",  QDLSS_RC_DESCRIPTION
            VALUE "FileVersion",      QDLSS_VERSION
            VALUE "InternalName",     QDLSS_PRODUCT
            VALUE "LegalCopyright",   "Copyright (c) 2026 Scott Dinwiddie. MIT License."
            VALUE "OriginalFilename", QDLSS_RC_FILENAME
            VALUE "ProductName",      QDLSS_RC_PRODUCT
            VALUE "ProductVersion",   QDLSS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
